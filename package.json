{
  "name": "plate-curator-vercel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests --exclude \"tests-emulator/**\" && node --test scripts/hygiene/*.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "test:emulator": "npx --yes firebase-tools@15.36.0 emulators:exec --only firestore --project demo-plate-curator \"vitest run tests-emulator --no-file-parallelism\"",
    "worker": "tsx worker/main.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@vercel/oidc": "^4.0.9",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "firebase": "^13.3.0",
    "google-auth-library": "^11.3.4",
    "jose": "^6.2.17",
    "next": "^16.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "workflow": "^5.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^5.1.0"
  }
}
